{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecordFlow",
  "version": "1.3.0",
  "identifier": "com.recordflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RecordFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**",
          "$HOME/**",
          "$VIDEO/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "shortDescription": "Screen and Camera Recording App",
    "longDescription": "RecordFlow is a lightweight Windows desktop app for recording your screen with an optional camera overlay and microphone audio.",
    "category": "Utility",
    "publisher": "RecordFlow"
  }
}
